# 复制成 aics.env 再填自己的值（aics.env 已被 .gitignore 忽略，不会被提交）
#
# 值从哪来：平台的开发环境页面里跑 browser/probe_env.js，它会把下面几行直接打出来。
#
# AICS_HOST / AICS_PORT / AICS_USER / AICS_PASSWORD 是「容器」的接入信息；
# AICS_SOCKS 是你本机的 SOCKS5 代理（先用 SSH 动态转发起一个隧道）。

AICS_HOST=aics.cambricon.com
AICS_PORT=替换成你的 SSH NodePort
AICS_USER=root
AICS_PASSWORD=替换成探针打印出来的密码
AICS_SOCKS=127.0.0.1:1080

# 可选：改用私钥登录（设置了就忽略 AICS_PASSWORD）
# AICS_KEY=C:/Users/you/.ssh/id_rsa

# 可选：SOCKS5 代理需要用户名密码认证时
# AICS_SOCKS_USER=
# AICS_SOCKS_PASSWORD=
